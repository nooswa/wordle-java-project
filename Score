package wordle;

import java.io.File;
import java.io.FileWriter;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.Scanner;
import java.util.ArrayList;
import java.util.List;

public class Score {

    private final static String HISTORY_PATH = "History.txt";

    public void recordGame(WordleGame game) throws Exception {
        // Read existing data from file
        List<String> lines = Files.readAllLines(Path.of(HISTORY_PATH));
        int gamesPlayed = 0;
        int gamesWon = 0;
        List<String> winningWords = new ArrayList<>();

        if (lines.size() > 0) {
            // Parse games played and games won
            String[] gamesPlayedLine = lines.get(0).split(":");
            if (gamesPlayedLine.length > 1) {
                gamesPlayed = Integer.parseInt(gamesPlayedLine[1].trim());
            }
            String[] gamesWonLine = lines.get(1).split(":");
            if (gamesWonLine.length > 1) {
                gamesWon = Integer.parseInt(gamesWonLine[1].trim());
            }
            // Collect existing winning words
            for (int i = 3; i < lines.size(); i++) {
                winningWords.add(lines.get(i));
            }
        }

        // Update games played count
        gamesPlayed++;

        // Check if the game was won and update winning words
        if (game.didWin()) {
            gamesWon++;
            winningWords.add(game.getSecretWord());
        }

        // Write updated data back to the file
        try (FileWriter writer = new FileWriter(HISTORY_PATH)) {
            writer.write(String.format("Games Played: %d\n", gamesPlayed));
            writer.write(String.format("Games Won: %d\n", gamesWon));
            writer.write("Winning Words:\n");
            for (String word : winningWords) {
                writer.write(word + "\n");
            }
        } catch (IOException e) {
            System.err.println("Error writing to file: " + e.getMessage());
        }
    }
}
