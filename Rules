package wordle;


public class Rules {
    
    public boolean rulesDisplayed = false;
    
    public String getRules() {  
        return "*Each guess must be a valid five-letter word.\n" +
               "*The background of a letter will change to show you how close your guess was.\n" +
               "*If the background turns green, the letter is in the word, and it is in the correct spot.\n" +
               "*If the background turns yellow, the letter is in the word, but it is not in the correct spot.\n\n" +
                "*To exit the game at any time, enter \"exit game\"." +
               "*If you ever need to display the rules again, enter \"show rules\".";
    }
    
    public void displayRulesFirstRun() {
        if (!rulesDisplayed) {
            System.out.println(getRules());
            rulesDisplayed = true;
        }
    }
  
}
