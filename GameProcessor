package wordle;

public class GameProcessor {
    private final String secretWord;
    private final InputHandler inputHandler;
    private final FeedbackDisplay feedbackDisplay;

    public GameProcessor(String secretWord, InputHandler inputHandler) {
        this.secretWord = secretWord;
        this.inputHandler = inputHandler;
        this.feedbackDisplay = new FeedbackDisplay();
    }

    public void startGame(int maxAttempts) {
        boolean isGameWon = false;

        // Display the secret word for testing purposes
        System.out.println("SECRET WORD (for testing): " + secretWord);

        for (int attempt = 1; attempt <= maxAttempts; attempt++) {
            System.out.println("Attempt " + attempt + " of " + maxAttempts);

            // Get user guess
            String guess = inputHandler.getUserInput();

            // Generate feedback and store it
            String feedback = feedbackDisplay.generateFeedback(guess, secretWord);

            // Display all feedback history
            feedbackDisplay.displayFeedbackHistory();

            // Check if the guess is correct
            if (guess.equals(secretWord)) {
                System.out.println("Congratulations! You've guessed the word correctly!");
                isGameWon = true;
                break;
            }
        }

        if (!isGameWon) {
            System.out.println("You've run out of attempts! The correct word was: " + secretWord);
        }
    }
}
